<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= lang === 'hu' ? 'Csaták' : lang === 'ro' ? 'Bătălii' : 'Battles' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        .timeline-container {
            position: relative;
            padding: 2rem 0;
        }
        .timeline-line {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 3px;
            height: 100%;
            background: linear-gradient(to bottom, var(--accent-color), rgba(255, 0, 0, 0.3));
        }
        .timeline-item {
            margin-bottom: 3rem;
            position: relative;
        }
        .timeline-item:nth-child(odd) .battle-content {
            margin-left: 0;
            margin-right: auto;
            width: calc(50% - 2rem);
            text-align: right;
        }
        .timeline-item:nth-child(even) .battle-content {
            margin-left: auto;
            margin-right: 0;
            width: calc(50% - 2rem);
            text-align: left;
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 1.5rem;
            transform: translateX(-50%);
            width: 20px;
            height: 20px;
            background: var(--accent-color);
            border-radius: 50%;
            border: 3px solid #1a1a1a;
            z-index: 10;
        }
        .timeline-year {
            position: absolute;
            left: 50%;
            top: 0.5rem;
            transform: translateX(-50%);
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--accent-color);
            background: #1a1a1a;
            padding: 0.25rem 0.75rem;
            border-radius: 8px;
            z-index: 11;
            min-width: 60px;
            text-align: center;
        }
        .battle-content {
            background: linear-gradient(135deg, var(--dark-bg), #2a2a4a);
            border: 1px solid var(--accent-color);
            border-radius: 12px;
            padding: 1.5rem;
            transition: all 0.3s ease;
        }
        .battle-content:hover {
            background: linear-gradient(135deg, var(--dark-bg), #393961);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(255, 0, 0, 0.2);
        }
        .battle-title {
            color: var(--accent-color);
            font-weight: bold;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .timeline-item:nth-child(even) .battle-title {
            justify-content: flex-start;
        }
        .timeline-item:nth-child(odd) .battle-title {
            justify-content: flex-end;
        }
        @media (max-width: 768px) {
            .timeline-line {
                left: 15px;
            }
            .timeline-item:nth-child(odd) .battle-content,
            .timeline-item:nth-child(even) .battle-content {
                width: calc(100% - 50px);
                margin-left: 50px;
                margin-right: 0;
                text-align: left;
            }
            .timeline-item::before {
                left: 15px;
            }
            .timeline-year {
                left: 15px;
                transform: translateX(-50%);
            }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main>
        <section class="detail-header">
            <div class="container">
                <h1><i class="fas fa-timeline"></i> <%= lang === 'hu' ? 'Csaták Időrendi Sorrendben' : lang === 'ro' ? 'Bătălii în Ordine Cronologică' : 'Battles in Chronological Order' %></h1>
                <p class="lead"><%= lang === 'hu' ? 'A WWII legjelentősebb összecsapásai az időrendi sorrendben rendezve' : lang === 'ro' ? 'Cele mai importante confruntări ale celui de-al Doilea Război Mondial în ordine cronologică' : 'The most significant clashes of WWII arranged chronologically' %></p>
            </div>
        </section>

        <div class="container py-5">
            <div class="timeline-container">
                <div class="timeline-line"></div>
                
                <% battles.forEach((battle, index) => { %>
                    <div class="timeline-item">
                        <div class="timeline-year"><%= battle.year %></div>
                        <div class="battle-content">
                            <div class="battle-title">
                                <i class="fas fa-crossed-swords"></i>
                                <%= battle.name[lang] %>
                            </div>
                            <p style="margin-bottom: 0.75rem; font-size: 0.95rem;">
                                <%= battle.description[lang].substr(0, 180) + (battle.description[lang].length > 180 ? '...' : '') %>
                            </p>
                            <a href="/battle/<%= battle.id %>?lang=<%= lang %>" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-arrow-right"></i> <%= lang === 'hu' ? 'Részletek' : lang === 'ro' ? 'Detalii' : 'Details' %>
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </main>

    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2026 WWII History</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>